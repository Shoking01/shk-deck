# Rust build output. There are three workspace roots (the repository root,
# crates/ss550-gui and crates/ss550-tray), so this pattern is unanchored on
# purpose and matches every `target/` directory.
target/

# CodeGraph's local index: machine-specific, rebuilt from the sources.
.codegraph/

# Editor and OS noise.
.vscode/
.idea/
*.log
Thumbs.db

# Kept from the previous generation: they may come back with the vendored
# WebSocket SDK or a Node tool, and a stray 200 MB node_modules is not worth
# discovering in a diff.
node_modules/
third_party/
